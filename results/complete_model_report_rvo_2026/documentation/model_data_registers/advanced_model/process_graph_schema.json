    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "nodes",
    "edges"
  ],
  "title": "GreenHub ProcessGraph",
  "type": "object"
}
