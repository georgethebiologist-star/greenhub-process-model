        "properties": {
          "active": {
            "type": "boolean"
          },
          "calculation_mode": {
            "type": "string"
          },
          "dashboard_group": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "key_kpis": {
            "type": "object"
          },
          "model_maturity": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "process_area": {
            "type": "string"
          },
          "technology": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit_id": {
            "type": "string"
          },
          "warning_count": {
            "minimum": 0,
            "type": "integer"
          }
