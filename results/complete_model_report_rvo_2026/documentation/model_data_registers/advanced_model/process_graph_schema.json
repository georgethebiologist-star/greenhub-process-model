              "null"
            ]
          },
          "stream_id": {
            "type": "string"
          },
          "target_node": {
            "type": [
              "string",
              "null"
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "edge_id",
          "stream_id",
          "source_node",
          "target_node",
          "mass_flow",
          "phase",
          "active"
