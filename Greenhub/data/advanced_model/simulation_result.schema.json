        "type": "object"
      },
      "type": "array"
    },
    "calculation_mode": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "dataset_readiness": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "export_references": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "graph": {
      "$ref": "#/$defs/process_graph"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
