    },
    "plots": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "process_areas": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "products": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "reproducibility_metadata": {
      "type": "object"
    },
    "request_id": {
      "type": "string"
    },
    "resolution_mode": {
      "type": "string"
    },
    "resolved_parameters": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "selected_scenarios": {
      "additionalProperties": false,
      "properties": {
        "anaerobic_digestion": {
          "default": "AD1",
          "type": "string"
        },
        "biogas_upgrading": {
          "default": "BG2",
          "type": "string"
        },
        "feed_preparation": {
          "default": "F2",
          "type": "string"
        },
        "nutrient_recovery": {
          "default": "NR4",
          "type": "string"
        },
        "process_order": {
          "default": "A",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "type": "string"
        },
        "protein_recovery": {
          "default": "PR3",
          "type": "string"
        }
      },
      "type": "object"
    },
    "status": {
      "type": "string"
    },
    "streams": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
