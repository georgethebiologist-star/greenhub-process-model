        "$ref": "#/$defs/numerical_value"
      },
      "type": "object"
    },
    "units": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "utilities": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "validation": {
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
