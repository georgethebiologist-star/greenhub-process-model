    "request_id",
    "status",
    "selected_scenarios",
    "calculation_mode",
    "resolution_mode",
    "summary_kpis",
    "process_areas",
    "streams",
    "units",
    "products",
    "utilities",
    "balances",
    "validation",
    "resolved_parameters",
