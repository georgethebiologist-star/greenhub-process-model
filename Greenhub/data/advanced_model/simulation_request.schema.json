{
  "$defs": {
    "biomass_schedule": {
      "additionalProperties": false,
      "properties": {
        "active_months": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "annual_available_biomass_tonnes": {
          "default": 30000,
          "minimum": 0,
          "type": "number"
        },
        "annual_processed_biomass_tonnes": {
          "default": 30000,
          "minimum": 0,
          "type": "number"
        },
        "collection_refinery_fraction": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "feed_basis": {
          "enum": [
            "tonnes_per_year",
            "kg_per_hr"
          ],
          "type": "string"
        },
        "feed_kg_per_hr": {
          "minimum": 0,
          "type": "number"
        },
        "peak_date": {
          "format": "date",
          "type": "string"
        },
        "processing_delay_days": {
          "default": 14,
          "maximum": 365,
          "minimum": 0,
          "type": "integer"
        },
        "season_end": {
          "format": "date",
          "type": "string"
        },
        "season_start": {
          "format": "date",
          "type": "string"
        },
        "spread_days": {
          "maximum": 366,
          "minimum": 1,
          "type": "number"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "biostimulant_route": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "flux_L_m2_h",
            "flux_source"
          ]
        },
        {
          "required": [
            "feed_to_reference_concentration_ratio",
            "flux_model_source",
            "transmembrane_pressure_bar",
            "pressure_source",
            "viscosity_Pa_s",
            "viscosity_source"
          ]
        }
      ],
      "properties": {
        "cip_input_source": {
          "description": "Required source/evidence note when CIP volume and make-up fraction are supplied.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "cip_makeup_fraction_per_cycle": {
          "description": "Fraction of each CIP working-solution batch replaced/made up after each event; requires volume and evidence note.",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "cip_solution_volume_L_per_step": {
          "description": "Optional same nominal working-solution volume for each sequential CIP step; requires make-up fraction and evidence note.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "component_retention_override_sources": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "component_retention_overrides": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "type": "object"
        },
        "crossflow_electricity_kwh_m3_feed": {
          "description": "Optional explicit crossflow recirculation electricity per m3 clarified feed; added to BioSTEAM electricity utilities and excludes separately modeled permeate-side pressure work.",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "crossflow_electricity_source": {
          "description": "Required measurement/source note when crossflow_electricity_kwh_m3_feed is supplied.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "feed_to_reference_concentration_ratio": {
          "description": "Optional Cf/C0 ratio for resistance-based flux calculation; no default is assumed.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "flux_L_m2_h": {
          "description": "Explicit empirical operating flux. Select this or the resistance method, not both.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "flux_model_source": {
          "description": "Required evidence/basis note for the supplied Cf/C0 input.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "flux_source": {
          "description": "Evidence note required when an explicit empirical flux is supplied.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "hormone_benchmark_source": {
          "description": "Required evidence note when use_hormone_benchmarks is true.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "pressure_source": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "pump_efficiency_fraction": {
          "description": "Optional; when supplied it requires TMP and its own source note.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": [
            "number",
            "null"
          ]
        },
        "pump_efficiency_source": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "retention_matrix_source": {
          "minLength": 1,
          "type": "string"
        },
        "technology_id": {
          "enum": [
            "TUF",
            "LNF",
            "MEUF"
          ],
          "type": "string"
        },
        "transmembrane_pressure_bar": {
          "description": "Optional TMP; required with Cf/C0 for resistance-based flux, or with pump efficiency for pressure-work electricity.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "use_hormone_benchmarks": {
          "default": false,
          "description": "Explicitly add the user-supplied clarified-juice hormone benchmark as a separately tracked screening analyte feed; off by default.",
          "type": "boolean"
        },
        "viscosity_Pa_s": {
          "description": "Measured clarified-juice viscosity for the active no-fermentation feed; fermented-juice register value is not reused.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "viscosity_source": {
          "description": "Evidence note required with viscosity_Pa_s for the resistance flux method.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "technology_id",
        "retention_matrix_source"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "initial_storage_inventory": {
      "additionalProperties": false,
      "properties": {
        "component_mass_fractions": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "type": "object"
        },
        "moisture_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "storage_age_h": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "temperature_k": {
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "total_mass_kg": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "operating_schedule": {
      "additionalProperties": false,
      "properties": {
        "operating_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        },
        "operating_days_per_week": {
          "maximum": 7,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "operating_hours_per_day": {
          "maximum": 24,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "shutdown_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        },
        "target_throughput_kg_hr": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "parameter_override": {
      "additionalProperties": false,
      "properties": {
        "parameter_id": {
          "minLength": 1,
          "type": "string"
        },
        "provenance_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "rebuild_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "requester": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        }
      },
      "required": [
        "parameter_id",
        "value"
      ],
      "type": "object"
    },
    "parameter_overrides": {
      "items": {
        "$ref": "#/$defs/parameter_override"
      },
      "type": "array"
    },
    "scenario_selection": {
      "additionalProperties": false,
      "properties": {
        "anaerobic_digestion": {
          "default": "AD1",
          "type": "string"
        },
        "biogas_upgrading": {
          "default": "BG2",
          "type": "string"
        },
        "feed_preparation": {
          "default": "F1",
          "type": "string"
        },
        "nutrient_recovery": {
          "default": "NR4",
          "type": "string"
        },
        "process_order": {
          "default": "A",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "type": "string"
        },
        "protein_recovery": {
          "default": "PR3",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "simulation_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annual_biomass_target": {
      "exclusiveMinimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "biomass_schedule": {
      "$ref": "#/$defs/biomass_schedule"
    },
    "biostimulant_route": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "flux_L_m2_h",
            "flux_source"
          ]
        },
        {
          "required": [
            "feed_to_reference_concentration_ratio",
            "flux_model_source",
            "transmembrane_pressure_bar",
            "pressure_source",
            "viscosity_Pa_s",
            "viscosity_source"
          ]
        }
      ],
      "properties": {
        "cip_input_source": {
          "description": "Required source/evidence note when CIP volume and make-up fraction are supplied.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "cip_makeup_fraction_per_cycle": {
          "description": "Fraction of each CIP working-solution batch replaced/made up after each event; requires volume and evidence note.",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "cip_solution_volume_L_per_step": {
          "description": "Optional same nominal working-solution volume for each sequential CIP step; requires make-up fraction and evidence note.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "component_retention_override_sources": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "component_retention_overrides": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "type": "object"
        },
        "crossflow_electricity_kwh_m3_feed": {
          "description": "Optional explicit crossflow recirculation electricity per m3 clarified feed; added to BioSTEAM electricity utilities and excludes separately modeled permeate-side pressure work.",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "crossflow_electricity_source": {
          "description": "Required measurement/source note when crossflow_electricity_kwh_m3_feed is supplied.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "feed_to_reference_concentration_ratio": {
          "description": "Optional Cf/C0 ratio for resistance-based flux calculation; no default is assumed.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "flux_L_m2_h": {
          "description": "Explicit empirical operating flux. Select this or the resistance method, not both.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "flux_model_source": {
          "description": "Required evidence/basis note for the supplied Cf/C0 input.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "flux_source": {
          "description": "Evidence note required when an explicit empirical flux is supplied.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "hormone_benchmark_source": {
          "description": "Required evidence note when use_hormone_benchmarks is true.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "pressure_source": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "pump_efficiency_fraction": {
          "description": "Optional; when supplied it requires TMP and its own source note.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": [
            "number",
            "null"
          ]
        },
        "pump_efficiency_source": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "retention_matrix_source": {
          "minLength": 1,
          "type": "string"
        },
        "technology_id": {
          "enum": [
            "TUF",
            "LNF",
            "MEUF"
          ],
          "type": "string"
        },
        "transmembrane_pressure_bar": {
          "description": "Optional TMP; required with Cf/C0 for resistance-based flux, or with pump efficiency for pressure-work electricity.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "use_hormone_benchmarks": {
          "default": false,
          "description": "Explicitly add the user-supplied clarified-juice hormone benchmark as a separately tracked screening analyte feed; off by default.",
          "type": "boolean"
        },
        "viscosity_Pa_s": {
          "description": "Measured clarified-juice viscosity for the active no-fermentation feed; fermented-juice register value is not reused.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "viscosity_source": {
          "description": "Evidence note required with viscosity_Pa_s for the resistance flux method.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "technology_id",
        "retention_matrix_source"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "calculation_mode": {
      "default": "structural",
      "enum": [
        "structural",
        "literature_default",
        "project_data",
        "calibrated",
        "expert_override"
      ],
      "type": "string"
    },
    "design_overrides": {
      "$ref": "#/$defs/parameter_overrides"
    },
    "end_date": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "expert_scientific_overrides": {
      "$ref": "#/$defs/parameter_overrides"
    },
    "export_formats": {
      "items": {
        "enum": [
          "json",
          "csv"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "feed_composition": {
      "additionalProperties": {
        "maximum": 1.1,
        "minimum": 0,
        "type": "number"
      },
      "description": "Wet-mass fractions for canonical GreenHub compound IDs only. If omitted or empty, the canonical GreenHub feed profile is applied. Supplied totals from 0.90 to 1.10 are normalized to 1.00 by the request contract.",
      "type": "object",
      "x-normalized-total": 1.0,
      "x-total-maximum": 1.1,
      "x-total-minimum": 0.9
    },
    "feed_overrides": {
      "$ref": "#/$defs/parameter_overrides"
    },
    "feed_supply_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "initial_storage_inventory": {
      "$ref": "#/$defs/initial_storage_inventory"
    },
    "operating_overrides": {
      "$ref": "#/$defs/parameter_overrides"
    },
    "operating_schedule": {
      "$ref": "#/$defs/operating_schedule"
    },
    "plant_capacity_kg_hr": {
      "exclusiveMinimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "project_id": {
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "requested_outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail_level": {
            "default": "summary",
            "type": "string"
          },
          "output_id": {
            "type": "string"
          }
        },
        "required": [
          "output_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "requested_plots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "formats": {
            "items": {
              "enum": [
                "json",
                "csv",
                "png",
                "svg"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "plot_id": {
            "type": "string"
          }
        },
        "required": [
          "plot_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "resolution_mode": {
      "default": "steady_state",
      "enum": [
        "steady_state",
        "monthly_independent",
        "quasi_dynamic",
        "dynamic"
      ],
      "type": "string"
    },
    "scenarios": {
      "$ref": "#/$defs/scenario_selection"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "selected_month": {
      "default": "July",
      "type": [
        "string",
        "null"
      ]
    },
    "start_date": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "storage_conditions": {
      "description": "Opt-in component retention or source-gated grass reaction package; see decision-support options.",
      "type": [
        "object",
        "null"
      ]
    },
    "strict_validation": {
      "default": true,
      "type": "boolean"
    },
    "time_horizon": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "type": [
        "array",
        "null"
      ]
    },
    "time_step": {
      "enum": [
        "monthly",
        "weekly",
        "daily",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "user_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "wet_feed_rate_kg_hr": {
      "exclusiveMinimum": 0,
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "project_id"
  ],
  "title": "GreenHub SimulationRequest",
  "type": "object"
}
