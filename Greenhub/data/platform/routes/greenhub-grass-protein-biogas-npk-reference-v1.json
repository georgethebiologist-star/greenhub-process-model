  "technology_instances": [
    {
      "instance_id": "gh-primary-fractionation",
      "technology_family_id": "pretreatment_fractionation",
      "technology_id": "greenhub-grass-press-and-primary-separation",
      "project_specific": true,
      "input_stream_ids": ["raw_grass"],
      "output_stream_ids": ["press_juice", "press_cake"],
      "parameter_bindings": [
        {"parameter_id": "feed_profile", "unit": "material profile identifier", "binding_kind": "project_material_profile", "scenario_overridable": true},
