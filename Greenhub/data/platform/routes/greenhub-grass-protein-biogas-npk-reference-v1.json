    {"stream_id": "raw_biogas", "material_state_id": "greenhub.ad.raw_biogas", "from": "gh-residual-anaerobic-digestion", "to": "gh-biogas-upgrading", "stream_role": "intermediate", "composition_scope": "mixed_declared_bases", "mass_balance_basis": "component_mass"},
