      ],
      "activation_state": "reference_only",
      "limitations": ["Batch BMP is potential, not continuous reactor performance; feed-specific kinetics, inhibition and stability are unvalidated."]
    },
    {
      "instance_id": "gh-biogas-upgrading",
      "technology_family_id": "biogas_upgrading",
      "technology_id": "selected-upgrading-route",
      "project_specific": false,
