      "technology_family_id": "protein_recovery",
      "technology_id": "spray-drying-proxy",
      "project_specific": true,
      "input_stream_ids": ["wet_protein_cake"],
      "output_stream_ids": ["dried_protein_product", "evaporated_water"],
      "parameter_bindings": [
        {"parameter_id": "drying_target_moisture", "unit": "kg water/kg wet product", "binding_kind": "request_input", "scenario_overridable": true},
        {"parameter_id": "drying_energy", "unit": "kWh or MJ on a declared denominator", "binding_kind": "measurement_required", "scenario_overridable": true}
      ],
      "activation_state": "reference_only",
      "limitations": ["No grass-specific GreenHub dryer mass/energy balance is available; literature energy comparators retain their original bases and are not defaults."]
    },
    {
      "instance_id": "gh-residual-anaerobic-digestion",
      "technology_family_id": "anaerobic_digestion",
      "technology_id": "bmp-material-conversion-proxy",
      "project_specific": true,
      "input_stream_ids": ["protein_residual"],
      "output_stream_ids": ["raw_biogas", "digestate"],
      "parameter_bindings": [
        {"parameter_id": "residual_bmp", "unit": "m3 CH4/kg VS on declared normal-volume basis", "binding_kind": "project_parameter_registry", "scenario_overridable": true},
