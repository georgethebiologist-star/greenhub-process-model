      ],
      "activation_state": "reference_only",
      "limitations": ["Stream partition must be tied to the selected feed profile and a matched press measurement.", "Press cake is an external-route coproduct unless a validated process configuration explicitly includes it downstream."]
    },
    {
      "instance_id": "gh-protein-recovery",
      "technology_family_id": "protein_recovery",
      "technology_id": "greenhub-isoelectric-protein-recovery",
      "project_specific": true,
      "input_stream_ids": ["press_juice"],
      "output_stream_ids": ["wet_protein_cake", "protein_residual"],
      "parameter_bindings": [
        {"parameter_id": "protein_precipitation_pH", "unit": "pH", "binding_kind": "project_parameter_registry", "scenario_overridable": true},
        {"parameter_id": "protein_capture_fraction", "unit": "fraction of declared soluble-protein basis", "binding_kind": "measurement_required", "scenario_overridable": true}
