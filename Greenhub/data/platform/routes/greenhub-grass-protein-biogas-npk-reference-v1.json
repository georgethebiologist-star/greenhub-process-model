        {"parameter_id": "recovery_product_specification", "unit": "technology-specific product grade", "binding_kind": "project_parameter_registry", "scenario_overridable": true}
      ],
      "activation_state": "reference_only",
      "limitations": ["Nutrient recovery, product purity and fertilizer substitution are separate evidence gates."]
